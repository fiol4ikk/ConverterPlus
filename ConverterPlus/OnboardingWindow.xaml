<Window x:Class="ConverterPlus.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Converter+" Width="620" Height="460" MinWidth="560" MinHeight="400"
        Icon="Assets/converter-icon.png" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" Background="Transparent">
    <Border x:Name="WindowSurface" Background="{DynamicResource WindowSurface}" CornerRadius="12"
            BorderBrush="{DynamicResource Line}" BorderThickness="1" MouseLeftButtonDown="WindowSurface_MouseLeftButtonDown">
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource Accent}">
                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                   Foreground="{DynamicResource TextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="OnboardingAppTitle" Text="Converter+" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                        <TextBlock x:Name="OnboardingSubtitle" Text="Quick start" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="PageTitle" Text="Добро пожаловать" Focusable="True" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource Ink}" Margin="0,28,0,8" />
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="510">
                <TextBlock x:Name="PageBody" FontSize="15" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
                <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="8" Padding="14" Margin="0,20,0,0">
                    <TextBlock x:Name="PageDetail" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                </Border>
                <StackPanel x:Name="LinksPanel" Visibility="Collapsed" Margin="0,18,0,0">
                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap">
                        <Run x:Name="DeveloperLinkLabel" Text="Developer links: " />
                        <Hyperlink NavigateUri="https://guns.lol/fiolo4kap" RequestNavigate="Link_RequestNavigate"
                                   Foreground="{DynamicResource Accent}" Cursor="Hand">guns.lol/fiolo4kap</Hyperlink>
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0">
                        <Run x:Name="DonationLinkLabel" Text="Support the project: " />
                        <Hyperlink NavigateUri="https://www.donationalerts.com/r/fiol4ik" RequestNavigate="Link_RequestNavigate"
                                   Foreground="{DynamicResource Accent}" Cursor="Hand">Donate</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,24,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="PageDot1" Width="7" Height="7" Margin="0,0,6,0" />
                    <Ellipse x:Name="PageDot2" Width="7" Height="7" Margin="0,0,6,0" />
                    <Ellipse x:Name="PageDot3" Width="7" Height="7" />
                    <Ellipse x:Name="PageDot4" Width="7" Height="7" Margin="6,0,0,0" />
                    <Ellipse x:Name="PageDot5" Width="7" Height="7" Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="Back" Padding="14,8" Margin="0,0,8,0" Click="Back_Click" Visibility="Collapsed" />
                    <Button x:Name="NextButton" Content="Next" Padding="16,8" Style="{StaticResource PrimaryButton}" Click="Next_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
