<Window x:Class="ConverterPlus.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="420" Height="580" MinWidth="390" MinHeight="500"
        Icon="Assets/converter-icon.png"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="AccentSwatch" TargetType="RadioButton">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ring" Width="32" Height="32" CornerRadius="18" BorderThickness="2"
                                BorderBrush="Transparent" Padding="3" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="{DynamicResource HoverSurface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="WindowSurface" Background="{DynamicResource WindowSurface}" CornerRadius="8" BorderThickness="0"
            MouseLeftButtonDown="WindowSurface_MouseLeftButtonDown">
    <Grid Background="{DynamicResource Canvas}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="SettingsTitle" Text="Settings" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                <TextBlock x:Name="SettingsSubtitle" Text="Appearance and behavior" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="MinimizeSettingsButton" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize"
                        AutomationProperties.Name="Minimize">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button x:Name="CloseSettingsCaptionButton" Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="Close"
                        AutomationProperties.Name="Close">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="142" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="LanguageLabel" Text="Language" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    <ComboBox x:Name="LanguageSelector" Grid.Column="1" SelectedValuePath="Tag"
                              SelectedValue="{Binding Language, UpdateSourceTrigger=PropertyChanged}"
                              SelectionChanged="Language_SelectionChanged" ToolTip="Follow Windows language, or choose a language">
                        <ComboBoxItem Content="Automatic" Tag="Auto" />
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Русский" Tag="ru" />
                    </ComboBox>
                </Grid>
                <TextBlock x:Name="PersonalizationLabel" Text="Personalization" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                           Margin="0,0,0,12" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="142" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ThemeLabel" Text="Theme" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding ThemeMode, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem x:Name="ThemeSystemItem" Content="Use Windows setting" Tag="System" />
                        <ComboBoxItem x:Name="ThemeLightItem" Content="Light" Tag="Light" />
                        <ComboBoxItem x:Name="ThemeDarkItem" Content="Dark" Tag="Dark" />
                    </ComboBox>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="142" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="MaterialLabel" Text="Window material" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Material, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="Mica" Tag="Mica" />
                        <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                        <ComboBoxItem x:Name="MaterialSolidItem" Content="Solid" Tag="Solid" />
                    </ComboBox>
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="142" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="AccentLabel" Text="Accent color" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton x:Name="TealAccent" GroupName="Accent" Tag="Teal" Style="{StaticResource AccentSwatch}"
                                     ToolTip="Бирюзовый" AutomationProperties.Name="Бирюзовый" Checked="Accent_Checked">
                        <Ellipse Width="20" Height="20" Fill="#087F6B" />
                        </RadioButton>
                        <RadioButton x:Name="BlueAccent" GroupName="Accent" Tag="Blue" Style="{StaticResource AccentSwatch}"
                                     ToolTip="Синий" AutomationProperties.Name="Синий" Checked="Accent_Checked">
                        <Ellipse Width="20" Height="20" Fill="#0078D4" />
                        </RadioButton>
                        <RadioButton x:Name="RoseAccent" GroupName="Accent" Tag="Rose" Style="{StaticResource AccentSwatch}"
                                     ToolTip="Розовый" AutomationProperties.Name="Розовый" Checked="Accent_Checked">
                        <Ellipse Width="20" Height="20" Fill="#C43B6B" />
                        </RadioButton>
                        <RadioButton x:Name="OrangeAccent" GroupName="Accent" Tag="Orange" Style="{StaticResource AccentSwatch}"
                                     ToolTip="Оранжевый" AutomationProperties.Name="Оранжевый" Checked="Accent_Checked">
                        <Ellipse Width="20" Height="20" Fill="#B45A00" />
                        </RadioButton>
                        <RadioButton x:Name="VioletAccent" GroupName="Accent" Tag="Violet" Style="{StaticResource AccentSwatch}"
                                     ToolTip="Фиолетовый" AutomationProperties.Name="Фиолетовый" Checked="Accent_Checked">
                        <Ellipse Width="20" Height="20" Fill="#7357AA" />
                        </RadioButton>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,18" />
                <TextBlock x:Name="BehaviorLabel" Text="Behavior" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                           Margin="0,0,0,12" />
                <CheckBox x:Name="RememberFolderCheck" Content="Remember output folders" IsChecked="{Binding RememberLastFolder, UpdateSourceTrigger=PropertyChanged}"
                          Foreground="{DynamicResource Ink}" Margin="0,0,0,10" />
                <CheckBox x:Name="OpenFolderCheck" Content="Open output folder after processing" IsChecked="{Binding OpenOutputFolderAfterConversion, UpdateSourceTrigger=PropertyChanged}"
                          Foreground="{DynamicResource Ink}" Margin="0,0,0,10" />
                <TextBlock Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,8" TextWrapping="Wrap">
                    <Run x:Name="DeveloperAboutText" Text="Guns.lol — developer's social links: " />
                    <Hyperlink NavigateUri="https://guns.lol/fiolo4kap" RequestNavigate="DeveloperLink_RequestNavigate"
                               Foreground="{DynamicResource Accent}" Cursor="Hand">guns.lol/fiolo4kap</Hyperlink>
                    <LineBreak />
                    <Run x:Name="DonationAboutText" Text="Support the project: " />
                    <Hyperlink NavigateUri="https://www.donationalerts.com/r/fiol4ik" RequestNavigate="DeveloperLink_RequestNavigate"
                               Foreground="{DynamicResource Accent}" Cursor="Hand">Donate</Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button x:Name="DefaultsButton" Content="Defaults" HorizontalAlignment="Left" Click="Reset_Click" Padding="12,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseSettingsButton" Content="Close" IsCancel="True" Padding="14,8" Margin="0,0,8,0" />
                <Button x:Name="ApplySettingsButton" Content="Apply" IsDefault="True" Style="{StaticResource PrimaryButton}"
                        Click="Apply_Click" Padding="16,8" />
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
