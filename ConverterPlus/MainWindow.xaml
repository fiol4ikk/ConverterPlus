<Window x:Class="ConverterPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Converter+" Width="820" Height="560" MinWidth="700" MinHeight="480"
        Icon="Assets/converter-icon.png"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Background="Transparent" StateChanged="Window_StateChanged" Closing="MainWindow_Closing"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Border x:Name="WindowSurface" Background="{DynamicResource WindowSurface}" CornerRadius="8" BorderThickness="0"
            MouseLeftButtonDown="WindowSurface_MouseLeftButtonDown">
    <Grid x:Name="RootLayout" Margin="16" Background="{DynamicResource Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12" Background="Transparent"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" Background="{DynamicResource Accent}" CornerRadius="8" Margin="0,0,10,0">
                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextOnAccent}" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AppTitle" Text="Converter+" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                        <Button x:Name="CompressionModeButton" Click="CompressionMode_Click" Padding="8,4" MinHeight="28"
                                Margin="10,0,0,0" ToolTip="Switch compression mode" AutomationProperties.Name="Compression mode">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock x:Name="CompressionModeLabel" Text="Compress" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="AppSubtitle" Text="File conversion" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Background="{DynamicResource HeaderSurface}" CornerRadius="8"
                    Padding="10,7" MinWidth="225" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse x:Name="MediaEngineDot" Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="0,0,8,0" />
                        <TextBlock x:Name="MediaEngineSummary" Text="Audio and video ready" FontSize="11"
                                   Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DocumentEngineDot" Width="7" Height="7" Fill="{DynamicResource Warn}" Margin="0,0,8,0" />
                        <TextBlock x:Name="DocumentEngineSummary" Text="LibreOffice needed for documents" FontSize="10"
                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Button x:Name="SettingsButton" Grid.Column="2" Click="Settings_Click" Width="36" Height="36"
                    Padding="0" ToolTip="App settings" AutomationProperties.Name="App settings">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" />
            </Button>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="7,0,0,0">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize"
                        AutomationProperties.Name="Minimize">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click"
                        ToolTip="Maximize" AutomationProperties.Name="Maximize">
                    <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="Close"
                        AutomationProperties.Name="Close">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="8"
                Padding="11" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" Background="{DynamicResource AccentLight}" CornerRadius="7" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="OutputFolderLabel" Text="Save to" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                    <TextBox x:Name="OutputFolderBox" IsReadOnly="True" Focusable="False" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource Muted}" FontSize="12" VerticalContentAlignment="Center" Padding="0"
                             ToolTip="Folder for completed files" />
                </StackPanel>
                <Button Grid.Column="2" Click="ChooseFolder_Click" Padding="10,7" MinWidth="122">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0" />
                        <TextBlock x:Name="ChooseFolderLabel" Text="Choose folder" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="FilesHeading" Text="Files" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                <TextBlock x:Name="QueueCount" Text="Queue is empty" Foreground="{DynamicResource Muted}" FontSize="11"
                           VerticalAlignment="Center" Margin="9,2,0,0" />
            </StackPanel>
            <Button x:Name="AddFilesButton" Grid.Column="1" Click="AddFiles_Click" Padding="10,7" MinWidth="136" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" />
                    <TextBlock x:Name="AddFilesLabel" Text="Add files" FontSize="12" />
                </StackPanel>
            </Button>
            <Button x:Name="InstallDocsButton" Grid.Column="2" Click="InstallDocs_Click" Padding="9,7" FontSize="11"
                    Margin="0,0,8,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" />
                    <TextBlock Text="LibreOffice" />
                </StackPanel>
            </Button>
            <Button x:Name="ClearButton" Grid.Column="3" Click="Clear_Click" IsEnabled="False" Padding="9,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock x:Name="ClearLabel" Text="Clear" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="3">
            <Border x:Name="DropPanel" Background="{DynamicResource DropSurface}"
                    CornerRadius="8" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="410">
                    <Border Width="56" Height="56" CornerRadius="10" Background="{DynamicResource AccentLight}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" FontSize="23"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="DropTitle" Text="Drop files here" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                               HorizontalAlignment="Center" Margin="0,15,0,5" />
                    <TextBlock x:Name="DropHint" Text="or choose files with Add files" FontSize="12" Foreground="{DynamicResource Muted}"
                               HorizontalAlignment="Center" />
                    <Border Height="1" Width="200" Background="{DynamicResource Line}" Margin="0,16,0,13" HorizontalAlignment="Center" />
                    <TextBlock x:Name="FormatsHint" Text="Images   ·   Audio   ·   Video   ·   Documents" FontSize="11" Foreground="{DynamicResource Muted}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border x:Name="FilesPanel" Background="Transparent" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="10,0,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.6*" />
                            <ColumnDefinition Width="0.95*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FileColumnHeader" Text="File" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
                        <TextBlock x:Name="SizeColumnHeader" Grid.Column="1" Text="Size" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
                        <TextBlock x:Name="FormatColumnHeader" Grid.Column="2" Text="Format" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
                        <TextBlock x:Name="StatusColumnHeader" Grid.Column="3" Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="FilesList" ItemsSource="{Binding Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="8"
                                            Padding="10,7" Margin="0,0,0,8" Loaded="QueueCard_Loaded">
                                        <Border.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                         Opened="ContextMenu_Opened" MinWidth="170">
                                                <MenuItem Header="Copy path" Tag="CopyPath" Click="CopyPath_Click" />
                                                <Separator />
                                                <MenuItem Header="Remove from queue" Tag="Remove" Click="RemoveItem_Click" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid MinHeight="44" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.6*" />
                                                <ColumnDefinition Width="0.95*" />
                                                <ColumnDefinition Width="0.9*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="46" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource FileBadge}">
                                                    <TextBlock Text="{Binding SourceExtension}" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center" MinWidth="0">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                                                               Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Name}" />
                                                    <TextBlock Text="{Binding SourcePath}" FontSize="10" Foreground="{DynamicResource Muted}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                               ToolTip="{Binding SourcePath}" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Size}" FontSize="10" Foreground="{DynamicResource Muted}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Size}" />
                                                <TextBlock Text="{Binding OutputSize}" FontSize="11" Foreground="{DynamicResource Accent}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputSize}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding OutputSize}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding TargetFormats}"
                                                      SelectedItem="{Binding TargetFormat, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" MinWidth="0">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompressionMode}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                            <TextBlock Grid.Column="2" Text="{Binding TargetFormat}" FontSize="11"
                                                       Foreground="{DynamicResource Ink}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompressionMode}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="11"
                                                       Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Status}" VerticalAlignment="Center" />
                                            <Button Grid.Column="4" Style="{StaticResource IconButton}" ToolTip="Remove file"
                                                    FontFamily="Segoe MDL2 Assets" FontSize="14" Content="&#xE711;"
                                                    HorizontalAlignment="Center" Click="RemoveItem_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="0,0,8,0" />
                    <TextBlock x:Name="FooterStatus" Text="Add files to get started" Foreground="{DynamicResource Muted}" FontSize="11"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                </StackPanel>
                <TextBlock Text="made by fiol4ik with chatgpt" Foreground="{DynamicResource Muted}" FontSize="9"
                           Margin="15,2,0,0" />
            </StackPanel>
            <Grid x:Name="QualityControl" Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="QualityLabel" Text="Quality" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock x:Name="QualityHelpIcon" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="5,0,0,0"
                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                               ToolTip="Higher quality can increase file size and processing time." />
                </StackPanel>
                <Slider x:Name="ImageQualitySlider" Grid.Row="0" Grid.Column="1" Minimum="60" Maximum="100"
                        IsSnapToTickEnabled="False" VerticalAlignment="Center"
                        ValueChanged="ImageQuality_ValueChanged"
                        PreviewMouseLeftButtonUp="ImageQuality_MouseLeftButtonUp"
                        LostKeyboardFocus="QualitySlider_LostKeyboardFocus"
                        ToolTip="Controls JPEG, PNG, WebP, audio and video encoding. Lossless WAV/FLAC may not change size." />
                <TextBox x:Name="QualityValue" Grid.Row="0" Grid.Column="2" Width="42" Padding="0,0,0,2"
                         BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Line}"
                         Background="Transparent" Foreground="{DynamicResource Ink}"
                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                          TextAlignment="Right" ToolTip="Enter a value from 60 to 100%"
                         LostFocus="QualityValue_LostFocus" GotFocus="QualityValue_GotFocus" KeyDown="QualityValue_KeyDown" />
                <TextBlock x:Name="QualityHint" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="Higher quality takes longer"
                           Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
            <Grid x:Name="TargetSizeControl" Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TargetSizeLabel" Text="Size up to" Foreground="{DynamicResource Muted}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="TargetSizeValue" Grid.Column="1" Style="{StaticResource EntryTextBox}" Text="10" Width="58" Height="32"
                         Padding="7,3" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                         ToolTip="Desired maximum output size. Limit: 999 MB or 100 GB." MaxLength="3" PreviewTextInput="TargetSize_PreviewTextInput"
                         TextChanged="TargetSize_TextChanged" LostFocus="TargetSize_LostFocus" />
                <Button x:Name="TargetSizeUnitButton" Grid.Column="2" Height="32" MinHeight="32" Padding="8,4"
                        Margin="6,0,0,0" Click="TargetSizeUnit_Click" ToolTip="Target size unit">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TargetSizeUnitLabel" Text="MB" FontSize="11" />
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="7,0,0,0" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu Width="170" Placement="Top">
                            <MenuItem x:Name="MegabytesMenuItem" Header="Megabytes (MB)" Tag="MB" Click="TargetSizeUnitMenu_Click" />
                            <MenuItem x:Name="GigabytesMenuItem" Header="Gigabytes (GB)" Tag="GB" Click="TargetSizeUnitMenu_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
            <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Padding="15,11" Margin="0,0,10,0"
                    Click="Cancel_Click" Visibility="Collapsed" />
            <Button x:Name="ConvertButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Click="Convert_Click"
                    IsEnabled="False" MinWidth="174" Visibility="Collapsed" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0" />
                    <TextBlock x:Name="ConvertButtonLabel" Text="Convert" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
    </Border>
</Window>
